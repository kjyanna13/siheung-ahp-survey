# ─────────────────────────────────────────────────────────────
# Streamlit Community Cloud  →  앱 화면 우측 하단 Manage app
#   → Settings → Secrets 에 아래 내용을 그대로 붙여 넣습니다.
# 로컬에서 시험할 때는 이 파일을 secrets.toml 로 복사해 값을 채웁니다.
# secrets.toml 은 절대 깃허브에 올리지 마십시오(.gitignore에 등록되어 있습니다).
# ─────────────────────────────────────────────────────────────

[gcp_service_account]
type = "service_account"
project_id = "여기에-프로젝트-ID"
private_key_id = "여기에-키-ID"
private_key = "-----BEGIN PRIVATE KEY-----\n여러줄키를\\n로이어붙입니다\n-----END PRIVATE KEY-----\n"
client_email = "siheung-ahp@여기에-프로젝트-ID.iam.gserviceaccount.com"
client_id = "여기에-클라이언트-ID"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "여기에-인증서-URL"
universe_domain = "googleapis.com"

[sheets]
# 스프레드시트 주소 https://docs.google.com/spreadsheets/d/★이부분★/edit
spreadsheet_id = "여기에-스프레드시트-ID"
